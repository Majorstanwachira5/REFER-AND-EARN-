<%- include('layout/header', { title: 'Refer & Earn More - Unlock Your Earnings', user: typeof user !== 'undefined' ? user : null }) %>

<div class="landing-hero-container">
    <div class="split-auth-card">
        
        <!-- LEFT COLUMN: Auth Card (Login & Registration) -->
        <div class="auth-card-left">
            <div class="auth-header">
                <div class="auth-ram-logo">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="ram-svg-large">
                        <circle cx="32" cy="32" r="28" fill="url(#rem-bg-lg)" stroke="url(#rem-gold-lg)" stroke-width="3.5"/>
                        <text x="32" y="40" text-anchor="middle" font-family="'Outfit', sans-serif" font-weight="900" font-size="24" fill="url(#rem-gold-lg)" letter-spacing="1.5">REM</text>
                        <defs>
                            <linearGradient id="rem-bg-lg" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#071626"/>
                                <stop offset="100%" stop-color="#0f2d4e"/>
                            </linearGradient>
                            <linearGradient id="rem-gold-lg" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#ffe28a"/>
                                <stop offset="50%" stop-color="#f5a623"/>
                                <stop offset="100%" stop-color="#d4af37"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <h2 class="auth-title">Unlock Your Earnings</h2>
                <p class="auth-subtitle">Become a RAM Member & Start Earning Instant Commissions</p>
            </div>

            <!-- Tab Switcher -->
            <div class="auth-tabs">
                <button type="button" class="tab-btn <%= typeof activeTab === 'undefined' || activeTab === 'login' ? 'active' : '' %>" onclick="switchAuthTab('login')">
                    <i class="fa-solid fa-lock"></i> Member Sign In
                </button>
                <button type="button" class="tab-btn <%= typeof activeTab !== 'undefined' && activeTab === 'register' ? 'active' : '' %>" onclick="switchAuthTab('register')">
                    <i class="fa-solid fa-user-plus"></i> Join Network
                </button>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-banner error">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- LOGIN FORM -->
            <form id="login-form" action="/login" method="POST" class="auth-form <%= typeof activeTab === 'undefined' || activeTab === 'login' ? '' : 'hidden' %>">
                <div class="form-group">
                    <label for="login-email"><i class="fa-solid fa-envelope gold-text"></i> Email Address</label>
                    <input type="email" id="login-email" name="email" placeholder="user@example.com" required autocomplete="email">
                </div>

                <div class="form-group">
                    <label for="login-password"><i class="fa-solid fa-key gold-text"></i> Password</label>
                    <input type="password" id="login-password" name="password" placeholder="••••••••" required autocomplete="current-password">
                </div>

                <button type="submit" class="btn btn-gold btn-block btn-lg">
                    <i class="fa-solid fa-right-to-bracket"></i> Sign In To Dashboard
                </button>

                <div class="form-footer-note">
                    Don't have an account yet? <a href="javascript:void(0)" onclick="switchAuthTab('register')" class="gold-link">Register as a RAM Member</a>
                </div>
            </form>

            <!-- REGISTER FORM -->
            <form id="register-form" action="/register" method="POST" class="auth-form <%= typeof activeTab !== 'undefined' && activeTab === 'register' ? '' : 'hidden' %>">
                <div class="form-group">
                    <label for="reg-name"><i class="fa-solid fa-user gold-text"></i> Full Name</label>
                    <input type="text" id="reg-name" name="name" placeholder="John Doe" required autocomplete="name">
                </div>

                <div class="form-group">
                    <label for="reg-email"><i class="fa-solid fa-envelope gold-text"></i> Email Address</label>
                    <input type="email" id="reg-email" name="email" placeholder="john@example.com" required autocomplete="email">
                </div>

                <div class="form-group">
                    <label for="reg-password"><i class="fa-solid fa-key gold-text"></i> Create Password</label>
                    <input type="password" id="reg-password" name="password" placeholder="Minimum 6 characters" required autocomplete="new-password">
                </div>

                <div class="form-group">
                    <label for="reg-refcode"><i class="fa-solid fa-ticket gold-text"></i> Referral Code (Optional)</label>
                    <input type="text" id="reg-refcode" name="ref_code" value="<%= typeof ref_code !== 'undefined' ? ref_code : '' %>" placeholder="e.g. RAM8X92K" style="text-transform: uppercase;">
                    <small class="help-text">If referred by an active member, enter their code here.</small>
                </div>

                <div class="fee-notice-box">
                    <i class="fa-solid fa-circle-info gold-text"></i>
                    <span>One-time registration fee: <strong>KSh. 250</strong> (Paid after registration via Paystack).</span>
                </div>

                <button type="submit" class="btn btn-gold btn-block btn-lg">
                    <i class="fa-solid fa-bolt"></i> Register & Proceed to Pay KSh. 250
                </button>

                <div class="form-footer-note">
                    Already registered? <a href="javascript:void(0)" onclick="switchAuthTab('login')" class="gold-link">Sign In Here</a>
                </div>
            </form>
        </div>

        <!-- RIGHT COLUMN: How It Works & Instructions -->
        <div class="auth-card-right">
            <div class="instructions-container">
                <div class="instructions-header">
                    <span class="badge-gold">How It Works</span>
                    <h2>3 Simple Steps To Infinite Commissions</h2>
                    <p>Refer & Earn More operates on a high-yield, 2-tier commission network structure.</p>
                </div>

                <div class="steps-timeline">
                    <!-- Step 1 -->
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h3><i class="fa-solid fa-credit-card gold-text"></i> Step 1: Join</h3>
                            <p>Pay a one-time joining fee of <strong>KSh. 250</strong> via Paystack to activate your RAM account and unlock your dashboard.</p>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h3><i class="fa-solid fa-share-nodes gold-text"></i> Step 2: Refer</h3>
                            <p>Get your unique referral link (e.g. <code>ramnet.com/register?ref=RAM123</code>) and share it with friends, colleagues, and social networks.</p>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h3><i class="fa-solid fa-sack-dollar gold-text"></i> Step 3: Earn</h3>
                            <ul class="earning-highlights">
                                <li><i class="fa-solid fa-circle-check text-gold"></i> <strong>KSh. 100 Instant Commission</strong> for every Direct referral (Level 1).</li>
                                <li><i class="fa-solid fa-circle-check text-gold"></i> <strong>KSh. 50 Instant Commission</strong> for every Indirect referral (Level 2).</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Mathematical Breakdown Box -->
                <div class="math-proof-card">
                    <h4><i class="fa-solid fa-calculator gold-text"></i> Commission Math Example</h4>
                    <div class="math-grid">
                        <div class="math-item">
                            <span class="math-label">You Refer 10 Members (Level 1)</span>
                            <span class="math-val">10 × KSh. 100 = <strong>KSh. 1,000</strong></span>
                        </div>
                        <div class="math-item">
                            <span class="math-label">They Each Refer 10 Members (Level 2)</span>
                            <span class="math-val">100 × KSh. 50 = <strong>KSh. 5,000</strong></span>
                        </div>
                        <div class="math-total">
                            <span>Total Earnings on 10 Referrals:</span>
                            <span class="gold-price">KSh. 6,000.00</span>
                        </div>
                    </div>
                </div>

                <div class="instructions-cta">
                    <button type="button" class="btn btn-outline-gold btn-block" onclick="switchAuthTab('register')">
                        <i class="fa-solid fa-rocket"></i> Get Started Now - Join for KSh. 250
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<%- include('layout/footer') %>
