<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Refer & Earn More (RamNet) - Tiered Referral Network' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="app-header">
        <div class="header-container">
            <a href="/" class="brand-logo">
                <div class="ram-logo-icon">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="ram-svg">
                        <circle cx="32" cy="32" r="28" fill="url(#rem-bg-fhdr)" stroke="url(#rem-gold-fhdr)" stroke-width="3"/>
                        <text x="32" y="39" text-anchor="middle" font-family="'Outfit', sans-serif" font-weight="900" font-size="22" fill="url(#rem-gold-fhdr)" letter-spacing="1">REM</text>
                        <defs>
                            <linearGradient id="rem-bg-fhdr" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#071626"/>
                                <stop offset="100%" stop-color="#0f2d4e"/>
                            </linearGradient>
                            <linearGradient id="rem-gold-fhdr" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#ffe28a"/>
                                <stop offset="50%" stop-color="#f5a623"/>
                                <stop offset="100%" stop-color="#d4af37"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-name">Refer & Earn <span class="gold-text">More</span></span>
                    <span class="brand-tagline">RamNet Tiered Commissions</span>
                </div>
            </a>

            <nav class="header-nav">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="user-badge">
                        <span class="user-name"><i class="fa-solid fa-user-circle"></i> <%= user.name %></span>
                        <% if (Number(user.paid_status) === 1) { %>
                            <span class="status-badge active"><i class="fa-solid fa-check-circle"></i> Active Member</span>
                        <% } else { %>
                            <span class="status-badge pending"><i class="fa-solid fa-clock"></i> Pending KSh. 250 Fee</span>
                        <% } %>
                    </div>

                    <% if (Number(user.paid_status) === 1) { %>
                        <a href="/dashboard" class="nav-btn secondary"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                    <% } else { %>
                        <a href="/pay" class="nav-btn gold-pulse"><i class="fa-solid fa-bolt"></i> Pay KSh. 250</a>
                    <% } %>

                    <a href="/logout" class="nav-btn outline"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                <% } else { %>
                    <a href="/login" class="nav-btn primary"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <a href="/register" class="nav-btn gold"><i class="fa-solid fa-user-plus"></i> Register</a>
                <% } %>
            </nav>
        </div>
    </header>
    <main class="main-content">
