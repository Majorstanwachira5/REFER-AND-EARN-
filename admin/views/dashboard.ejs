<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RAM Admin Executive Control Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-nav { background: #071626; border-bottom: 2px solid #f5a623; }
        .platform-rev-card { background: linear-gradient(135deg, #1b436e 0%, #0d2847 100%); border: 2px solid #f5a623; }
    </style>
</head>
<body>
    <!-- Admin Header -->
    <header class="app-header admin-nav">
        <div class="header-container">
            <a href="/dashboard" class="brand-logo">
                <div class="ram-logo-icon">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="ram-svg">
                        <path d="M16 22C12 16 8 16 6 20C4 24 6 30 12 32C18 34 22 28 20 22Z" fill="url(#gold-grad-1)"/>
                        <path d="M48 22C52 16 56 16 58 20C46 34 42 28 44 22Z" fill="url(#gold-grad-1)"/>
                        <path d="M32 14C22 14 18 24 20 34C22 44 32 50 32 50C32 50 42 44 44 34C46 24 42 14 32 14Z" fill="url(#gold-grad-2)"/>
                        <circle cx="26" cy="30" r="3" fill="#0a2540"/>
                        <circle cx="38" cy="30" r="3" fill="#0a2540"/>
                        <polygon points="32,36 28,42 36,42" fill="#d4af37"/>
                        <defs>
                            <linearGradient id="gold-grad-1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#f5a623"/><stop offset="100%" stop-color="#d4af37"/></linearGradient>
                            <linearGradient id="gold-grad-2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#ffe28a"/><stop offset="100%" stop-color="#f5a623"/></linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-name">RAM <span class="gold-text">ADMIN PORTAL</span></span>
                    <span class="brand-tagline">Executive Management</span>
                </div>
            </a>

            <div class="header-nav">
                <span style="font-size: 0.9rem; color: #fff;"><i class="fa-solid fa-user-shield text-gold"></i> <%= adminUser.name %></span>
                <a href="http://localhost:8080/api-docs" target="_blank" class="nav-btn secondary"><i class="fa-solid fa-code"></i> Swagger API Docs</a>
                <a href="/logout" class="nav-btn outline"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="dashboard-container">
            
            <div class="dashboard-welcome-banner" style="background: linear-gradient(135deg, #0d2847 0%, #163c66 100%);">
                <div>
                    <h2>System Administrator Command Center</h2>
                    <p>Real-time platform financial tracking, 2-tier referral audit logs, and user management.</p>
                </div>
                <div class="user-code-badge">
                    <span class="badge-label">ROLE</span>
                    <span class="badge-code" style="font-size: 1.1rem; color: #f5a623;">SUPER ADMIN</span>
                </div>
            </div>

            <!-- Platform Stats Cards -->
            <div class="stats-grid">
                <!-- Total Revenue -->
                <div class="stat-card platform-rev-card">
                    <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
                    <div class="stat-details">
                        <span class="stat-label">Total Platform Revenue</span>
                        <h3 class="stat-value gold-text">KSh. <%= Number(stats.totalPlatformRevenue).toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></h3>
                        <span class="stat-earned">From <%= stats.paidAgents %> Paid Members (KSh. 250 fee)</span>
                    </div>
                </div>

                <!-- Total Commissions Paid Out -->
                <div class="stat-card">
                    <div class="stat-icon direct"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                    <div class="stat-details">
                        <span class="stat-label">Total Commissions Paid</span>
                        <h3 class="stat-value">KSh. <%= Number(stats.totalCommissionsPaid).toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></h3>
                        <span class="stat-earned">Distributed L1 (KSh. 100) & L2 (KSh. 50)</span>
                    </div>
                </div>

                <!-- Company Net Profit -->
                <div class="stat-card">
                    <div class="stat-icon total"><i class="fa-solid fa-chart-line"></i></div>
                    <div class="stat-details">
                        <span class="stat-label">Company Net Margin</span>
                        <h3 class="stat-value text-success">KSh. <%= Number(stats.companyNetMargin).toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></h3>
                        <span class="stat-earned">Net Platform Profit (KSh. 100 / user)</span>
                    </div>
                </div>

                <!-- User Counts -->
                <div class="stat-card">
                    <div class="stat-icon indirect"><i class="fa-solid fa-users"></i></div>
                    <div class="stat-details">
                        <span class="stat-label">Total Members Registered</span>
                        <h3 class="stat-value"><%= stats.totalAgents %> <span class="stat-sub">Members</span></h3>
                        <span class="stat-earned"><%= stats.paidAgents %> Active / <%= stats.unpaidAgents %> Unpaid</span>
                    </div>
                </div>
            </div>

            <!-- User Management Table -->
            <div class="dashboard-card" style="margin-top: 20px;">
                <div class="card-header">
                    <h3><i class="fa-solid fa-users-gear gold-text"></i> System Users Directory</h3>
                    <span class="badge-gold"><%= users.length %> Total Records</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>User Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Ref Code</th>
                                    <th>Wallet Balance</th>
                                    <th>Payment Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(u => { %>
                                    <tr>
                                        <td>#<%= u.id %></td>
                                        <td><strong><%= u.name %></strong></td>
                                        <td><%= u.email %></td>
                                        <td><span class="badge-level"><%= u.role %></span></td>
                                        <td><code><%= u.referral_code %></code></td>
                                        <td><strong class="gold-text">KSh. <%= Number(u.wallet_balance).toFixed(2) %></strong></td>
                                        <td>
                                            <% if (Number(u.paid_status) === 1) { %>
                                                <span class="badge-status-active">PAID / ACTIVE</span>
                                            <% } else { %>
                                                <span class="status-badge pending">UNPAID (KSh. 250)</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (Number(u.paid_status) !== 1 && u.role !== 'admin') { %>
                                                <button type="button" class="btn btn-sm btn-gold" onclick="manualActivateUser(<%= u.id %>)">
                                                    <i class="fa-solid fa-bolt"></i> Manual Activate
                                                </button>
                                            <% } else { %>
                                                <span class="text-success"><i class="fa-solid fa-check"></i> Activated</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- System Financial Transaction Feed -->
            <div class="dashboard-card" style="margin-top: 20px;">
                <div class="card-header">
                    <h3><i class="fa-solid fa-receipt gold-text"></i> System Financial Audit Feed</h3>
                </div>
                <div class="card-body">
                    <% if (transactions.length === 0) { %>
                        <p class="text-muted">No transactions recorded yet.</p>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Tx ID</th>
                                        <th>User Name</th>
                                        <th>User Email</th>
                                        <th>Description</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% transactions.forEach(tx => { %>
                                        <tr>
                                            <td>#<%= tx.id %></td>
                                            <td><strong><%= tx.user_name %></strong></td>
                                            <td><%= tx.user_email %></td>
                                            <td><%= tx.description %></td>
                                            <td><span class="<%= tx.type === 'credit' ? 'text-success' : 'text-danger' %>"><%= tx.type.toUpperCase() %></span></td>
                                            <td><strong class="<%= tx.type === 'credit' ? 'text-success' : 'text-danger' %>"><%= tx.type === 'credit' ? '+' : '-' %>KSh. <%= Number(tx.amount).toFixed(2) %></strong></td>
                                            <td><%= new Date(tx.created_at).toLocaleString() %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>
    </main>

    <script>
        const BACKEND_URL = "<%= backendUrl %>";

        async function manualActivateUser(userId) {
            if (!confirm(`Manually activate User #${userId} and trigger referral commissions?`)) return;

            try {
                const res = await fetch(`${BACKEND_URL}/api/admin/users/${userId}/activate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include'
                });

                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Activation Error: ' + data.message);
                }
            } catch (err) {
                alert('Server error: ' + err.message);
            }
        }
    </script>
</body>
</html>
